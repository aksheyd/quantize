+/// Add one block's products to `totals`, as [`dot_i8_row`] does.
+#[cfg_attr(not(debug_assertions), inline(always))]
+fn add_i8_block(totals: &mut [f32; LANES], bytes: &[u8], scale: f32, input: &[f32]) {
+    let (groups, _) = bytes.as_chunks::<32>();
+    let (group_inputs, _) = input.as_chunks::<32>();
